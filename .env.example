# Copy this file to `.env` and change the password. `.env` is git-ignored.
POSTGRES_USER=ecom
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Optional, only for the Airflow profile (docker compose --profile airflow up -d --build).
# These are demo values for a local machine; the defaults are used when they are not set.
# AIRFLOW_ADMIN_USER=airflow
# AIRFLOW_ADMIN_PASSWORD=airflow
# AIRFLOW_JWT_SECRET=change_me_to_a_long_random_string
# AIRFLOW_PORT=8080
